{
    "custom/clawd": {
        "exec": "~/.config/waybar/scripts/clawd/clawd.sh",
        "return-type": "json",
        "format": "{}",
        "on-click": "pkill -USR1 -f scripts/clawd/[c]lawd.sh",
        "on-click-right": "pkill -USR2 -f scripts/clawd/[c]lawd.sh",
        "tooltip": true
    }
}
